# Copy to .env for local dev (`vercel dev`). In Vercel, set these as project env vars.
# NEVER commit real values.

# "true" => sandbox endpoints + AUTHNET_SANDBOX_* credentials. Anything else => live.
AUTHNET_SANDBOX_MODE=true

# --- Sandbox credentials (one set per account: HB, PW, EXPO, PWSHOW) ---
AUTHNET_SANDBOX_PW_LOGIN_ID=
AUTHNET_SANDBOX_PW_TXN_KEY=
AUTHNET_SANDBOX_PW_CLIENT_KEY=
AUTHNET_SANDBOX_HB_LOGIN_ID=
AUTHNET_SANDBOX_HB_TXN_KEY=
AUTHNET_SANDBOX_HB_CLIENT_KEY=
AUTHNET_SANDBOX_EXPO_LOGIN_ID=
AUTHNET_SANDBOX_EXPO_TXN_KEY=
AUTHNET_SANDBOX_EXPO_CLIENT_KEY=
AUTHNET_SANDBOX_PWSHOW_LOGIN_ID=
AUTHNET_SANDBOX_PWSHOW_TXN_KEY=
AUTHNET_SANDBOX_PWSHOW_CLIENT_KEY=

# --- Live credentials (from Phil via 1Password; leave blank until then) ---
AUTHNET_PW_LOGIN_ID=
AUTHNET_PW_TXN_KEY=
AUTHNET_PW_CLIENT_KEY=
AUTHNET_HB_LOGIN_ID=
AUTHNET_HB_TXN_KEY=
AUTHNET_HB_CLIENT_KEY=
AUTHNET_EXPO_LOGIN_ID=
AUTHNET_EXPO_TXN_KEY=
AUTHNET_EXPO_CLIENT_KEY=
AUTHNET_PWSHOW_LOGIN_ID=
AUTHNET_PWSHOW_TXN_KEY=
AUTHNET_PWSHOW_CLIENT_KEY=

# --- Supabase (service role key: server-side only) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudflare Turnstile ---
# Site key is public and is returned by GET /api/config; secret stays server-side.
# Cloudflare's always-pass test pair for dev: site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Optional ---
# Extra allowed CORS origin when not in production (default http://localhost:8080)
# LOCAL_DEV_ORIGIN=http://localhost:8080

# --- Email (Resend) ---
RESEND_API_KEY=
# Must be an address on a domain verified in Resend, e.g. "Hatton-Brown Payments <payments@hattonbrown.com>"
EMAIL_FROM=
# Internal notification recipient(s), comma-separated. Default: hbcc@hattonbrown.com
# INTERNAL_NOTIFY_EMAIL=hbcc@hattonbrown.com
# Sandbox only: send internal notifications here instead, so test charges stay out of the real inbox
# SANDBOX_NOTIFY_EMAIL=
# Optional Reply-To on the customer receipt
# EMAIL_REPLY_TO=
# Time zone for the receipt date (default America/Chicago)
# EMAIL_TIMEZONE=America/Chicago
